# Base de données PostgreSQL locale (dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lynoralink_local"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/lynoralink_local"

# Configuration IA
AI_PROVIDER="cloudflare"
LLM_PROVIDER=cloudflare
FORCE_AGENT_MOCK="0"
LLM_MODEL="@cf/meta/llama-3.1-8b-instruct"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"
LLM_API_URL=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_GATEWAY_ID="default"
CLOUDFLARE_API_BASE="https://api.cloudflare.com/client/v4/accounts"
CLOUDFLARE_MODEL="@cf/meta/llama-3.1-8b-instruct"
CLOUDFLARE_IMAGE_MODEL="@cf/black-forest-labs/flux-1-schnell"
CLOUDFLARE_VIDEO_MODEL="@cf/meta/llama-3.1-8b-instruct"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generer_avec_openssl_rand_-base64_32"
NEXT_PUBLIC_BACKEND_URL="http://127.0.0.1:4001"
REDIS_URL="redis://127.0.0.1:6379"

# Web Push (generer avec: npx web-push generate-vapid-keys)
WEB_PUSH_EMAIL="mailto:admin@lynoralink.com"
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=""
WEB_PUSH_VAPID_PRIVATE_KEY=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PREMIUM_PRICE_ID_MONTHLY="price_monthly_..."
STRIPE_PREMIUM_PRICE_ID_YEARLY="price_yearly_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Cloudinary (pour les images et fichiers)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
NEXT_PUBLIC_CLOUDINARY_AVATAR_PRESET=""
NEXT_PUBLIC_CLOUDINARY_VIDEO_PRESET=""
NEXT_PUBLIC_CLOUDINARY_DOCUMENT_PRESET=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Fournisseur d'e-mails support
EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="LynoraLink Support <support@votre-domaine-verifie.com>"

# SMTP de secours (optionnel)
# Gmail : activer la validation en 2 étapes et utiliser un mot de passe d'application,
# jamais le mot de passe habituel du compte. Les espaces seront supprimés automatiquement.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@example.com"
SUPPORT_EMAIL_TO="support@lynoralink.com"
DEMO_EMAILS="hery.rakoto@lynoralink.com,fanja.rasolofoson@lynoralink.com"

# JWT
JWT_SECRET="generer_avec_openssl_rand_-base64_32"

# WebSocket (Real-time Features - Optional)
NEXT_PUBLIC_WEBSOCKET_URL="ws://localhost:3000"
WEBSOCKET_SECRET=""

# Admin
ADMIN_EMAIL="admin@example.com"
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# Real-time calling (Voice / Video) - WebRTC, TURN, Signaling and third-party providers
# Signaling server (WebSocket or similar) used to exchange SDP / ICE candidates
NEXT_PUBLIC_SIGNALING_SERVER_URL="ws://localhost:4000"

# ICE servers (STUN/TURN) - comma separated list of URLs
# Example: "stun:stun.l.google.com:19302,turn:turn.example.com:3478"
WEBRTC_STUN_SERVERS="stun:stun.l.google.com:19302"

# TURN server configuration (set if you run a TURN server or use a provider)
TURN_SERVER_URL="turn:turn.example.com:3478"
TURN_SERVER_USERNAME=""
TURN_SERVER_PASSWORD=""
TURN_TTL=3600

# Optional secret for ephemeral TURN or authentication
TURN_SERVER_SECRET=""

# LiveKit — appels vocaux et vidéo multi-participants
# Les clés API restent côté serveur et ne doivent jamais être préfixées par NEXT_PUBLIC_.
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
NEXT_PUBLIC_LIVEKIT_URL="wss://lynoralink-zq81w6x1.livekit.cloud"

# Third-party RTC providers (optional)
# Twilio Programmable Video / Programmable Voice
TWILIO_ACCOUNT_SID=""
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""

# Agora (optional)
AGORA_APP_ID=""
AGORA_APP_CERTIFICATE=""

# Feature toggles
ENABLE_VIDEO_CALLS=true
ENABLE_VOICE_CALLS=true

# Paiement des campagnes publicitaires
AD_CURRENCY="eur"
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
AD_PAYMENT_SUCCESS_URL="http://localhost:3000/feed?campaign_payment=success"
AD_PAYMENT_CANCEL_URL="http://localhost:3000/feed?campaign_payment=cancelled"
