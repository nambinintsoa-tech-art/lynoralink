generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  title         String?
  birthDate     DateTime?
  email         String    @unique
  emailVerified DateTime?
  password      String? // null si compte OAuth pur (Google / Facebook)
  image         String?
  cover         String?
  website       String?
  bio           String?
  location      String?
  company       String?
  sector        String?
  skills        String?   // JSON array stocké comme string
  plan          String    @default("FREE")
  autoReplyEnabled Boolean @default(false) @map("auto_reply_enabled")
  autoReplyTone String?   @default("friendly")
  autoReplyDefaultMessage String?
  autoReplyFaq  String?
  autoReplyMedia String?
  role          String    @default("user") // admin | moderator | user
  status        String    @default("active") // active | suspended | banned | deleted
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  posts              Post[]
  comments           Comment[]
  likes              Like[]
  savedPosts         SavedPost[]
  commentReactions   CommentReaction[] @relation("CommentReactions")
  subscription       Subscription?
  notifications      Notification[]
  sentNotifications  Notification[] @relation("NotificationSender")
  userSettings       UserSetting[]
  companyPosts       Post[]        @relation("CompanyPosts")
  reportsSent        Report[]       @relation("ReportReporter")

  connectionsA       Connection[] @relation("ConnectionUserA")
  connectionsB       Connection[] @relation("ConnectionUserB")
  removedBy          RemovedConnection[] @relation("RemovedByUser")
  removedUsers       RemovedConnection[] @relation("RemovedUser")
  conversationsA     Conversation[] @relation("ConversationUserA")
  conversationsB     Conversation[] @relation("ConversationUserB")
  conversationMembers ConversationMember[]
  sentMessages       Message[]
  messageReactions   MessageReaction[]
  messageDeletions   MessageDeletion[]
  callsStarted       CallSession[] @relation("CallSessionCaller")
  
  stories            Story[]
  storyViews         StoryView[]
  storyReactions     StoryReaction[]
  supportRequests    SupportRequest[]
  postShares         PostShare[]
  pushSubscriptions  PushSubscription[]
  autoReplyRules     AutoReplyRule[]
}

model AutoReplyRule {
  id        String   @id @default(cuid())
  userId    String
  dayOfWeek Int
  startTime String
  endTime   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
  @@map("auto_reply_rules")
}

model UserSetting {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PendingRegistration {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  title     String?
  birthDate DateTime?
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  companyPageId String?
  text      String?
  isArticle Boolean  @default(false)
  headline  String?
  excerpt   String?
  body      String?
  presentation String?
  mediaUrl  String?
  mediaType String?
  mediaData String?
  mood       String?  // JSON object { emoji, label }
  identifiedUsers String? // JSON array of user snapshots
  visibility String   @default("public") // public | connections | private
  status    String   @default("published") // pending_review | published | rejected
  reported  Boolean  @default(false)
  featured  Boolean  @default(false)
  isSponsored Boolean @default(false)
  campaignId String?
  createdAt DateTime @default(now())

  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  companyPage User?     @relation("CompanyPosts", fields: [companyPageId], references: [id], onDelete: SetNull)
  comments Comment[]
  likes    Like[]
  savedPosts SavedPost[]
  shares PostShare[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  text      String
  parentId  String?
  mediaData String?  // JSON array of media objects
  createdAt DateTime @default(now())

  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  reactions CommentReaction[]
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  reaction  String   @default("ok")
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, reaction])
}

model SavedPost {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model PostShare {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId, createdAt])
}

model CommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  reaction  String   @default("ok")
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation("CommentReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, reaction])
}

model Group {
  id            String   @id @default(cuid())
  ownerId       String?
  name          String
  emoji         String?
  description   String?
  category      String?
  coverGradient String?
  coverUrl      String?
  avatarUrl     String?
  privacy       String?  @default("public")
  postPermission String? @default("all")
  location      String?
  inviteLink    String?
  status        String   @default("active") // active | suspended
  members       String?  // JSON array
  joinRequests  String?  // JSON array
  joinQuestions String?  // JSON array of { id, label }
  posts         String?  // JSON array
  events        String?  // JSON array
  media         String?  // JSON array
  files         String?  // JSON array
  announcements String? // JSON array
  rules         String?  // JSON array
  tags          String?  // JSON array
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Connection {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  status    String   @default("accepted") // pending | accepted | rejected
  createdAt DateTime @default(now())

  userA User @relation("ConnectionUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("ConnectionUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
}

model RemovedConnection {
  id        String   @id @default(cuid())
  userId    String
  targetId  String
  createdAt DateTime @default(now())

  user   User @relation("RemovedByUser", fields: [userId], references: [id], onDelete: Cascade)
  target User @relation("RemovedUser", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId])
  @@index([userId])
}

model Conversation {
  id        String    @id @default(cuid())
  userAId   String
  userBId   String
  pageId    String?
  groupName String?
  isGroup   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userA     User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages  Message[]
  calls     CallSession[]
  members   ConversationMember[]

  @@unique([userAId, userBId, pageId])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id            String    @id @default(cuid())
  conversationId String
  senderId      String
  text          String
  mediaData     String?
  createdAt     DateTime  @default(now())
  readAt        DateTime?

  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender        User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions     MessageReaction[]
  deletions     MessageDeletion[]
  deletedForEveryone Boolean @default(false)
}

model MessageReaction {
  id            String       @id @default(cuid())
  messageId     String
  userId        String
  reaction      String
  createdAt     DateTime     @default(now())

  message       Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
}

model MessageDeletion {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
}

model CallSession {
  id               String       @id @default(cuid())
  conversationId   String
  callerId         String
  type             String
  status           String       @default("ringing")
  offer            String?
  answer           String?
  callerCandidates String       @default("[]")
  calleeCandidates String       @default("[]")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  endedAt          DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  caller       User         @relation("CallSessionCaller", fields: [callerId], references: [id], onDelete: Cascade)

  @@index([conversationId, updatedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  senderId  String?
  type      String   @default("info")
  actor     String   @default("LynoraLink")
  initials  String? 
  text      String
  message   String?
  read      Boolean  @default(false)
  meta      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender  User? @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id                   String              @id @default(cuid())
  userId               String              @unique
  stripeCustomerId     String              @unique
  stripeSubscriptionId String?             @unique
  stripePriceId        String?
  status               String              @default("INCOMPLETE")
  currentPeriodEnd     DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id          String   @id @default(cuid())
  type        String   // post | user | group
  targetId    String
  targetLabel String
  reporterId  String
  reporter    User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason      String
  details     String?
  status      String   @default("pending") // pending | reviewed | dismissed
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StatusCheck {
  id         String   @id @default(cuid())
  status     String
  latencyMs  Int
  checkedAt  DateTime @default(now())

  @@index([checkedAt])
}

model Story {
  id              String    @id @default(cuid())
  userId          String
  companyPageId   String?
  text            String?
  image           String?
  type            String    @default("text") // "text" | "image"
  backgroundColor String?
  privacy         String    @default("network") // "network" | "close" | "private"
  createdAt       DateTime  @default(now())
  expiresAt       DateTime

  author          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  views           StoryView[]
  reactions       StoryReaction[]

  @@index([userId])
  @@index([companyPageId])
  @@index([expiresAt])
}

model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  viewedAt  DateTime @default(now())

  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
}

model SupportRequest {
  id        String   @id @default(cuid())
  userId    String
  category  String
  subject   String
  message   String
  response  String?
  status    String   @default("open")
  respondedAt DateTime?
  respondedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model StoryReaction {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  reaction  String
  createdAt DateTime @default(now())

  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([storyId])
}
