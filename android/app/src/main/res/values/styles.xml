<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Edge-to-edge support -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Background and text colors -->
        <item name="android:windowBackground">@android:color/white</item>

        <!-- Modern look for light background -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- SplashScreen API theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Blue background for splash -->
        <item name="windowSplashScreenBackground">#152A4D</item>

        <!-- Dedicated splash artwork; adaptive launcher icons are enlarged and masked differently by Android devices. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash</item>

        <!-- Transition to main theme -->
        <item name="postSplashScreenTheme">@style/AppTheme</item>

        <!-- Ensure icons are white on blue background during splash -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Required for Capacitor -->
    <style name="AppTheme.NoActionBar" parent="AppTheme" />

    <!-- Default activity theme for startup -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.App.Starting" />
</resources>