{
  "name": "lynoralink",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:lan": "next dev --hostname 0.0.0.0",
    "dev:phone": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$ip = (Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.IPAddress -notlike '127.*' -and $_.IPAddress -notlike '169.254.*' -and $_.PrefixOrigin -ne 'WellKnown' } | Select-Object -First 1 -ExpandProperty IPAddress); if (-not $ip) { Write-Error 'Aucune adresse IPv4 locale trouvee'; exit 1 }; Write-Host ('LynoraLink accessible sur http://' + $ip + ':3000'); $env:NEXTAUTH_URL = 'http://' + $ip + ':3000'; $env:NEXT_PUBLIC_WEBSOCKET_URL = 'ws://' + $ip + ':3000'; $env:NEXT_PUBLIC_SIGNALING_SERVER_URL = 'ws://' + $ip + ':4000'; npx next dev --hostname 0.0.0.0\"",
    "backend:dev": "npm --prefix backend run dev",
    "backend:start": "npm --prefix backend run start",
    "migration:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-backend-migration.ps1",
    "tunnel": "npx ngrok http 3000",
    "build": "prisma generate && next build",
    "start": "node scripts/start-next.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "livekit-client": "^2.22.0",
    "livekit-server-sdk": "^2.18.0",
    "lucide-react": "^0.383.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.7",
    "nodemailer": "^7.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-is": "^18.3.1",
    "recharts": "^3.10.1",
    "redis": "^6.2.1",
    "sonner": "^2.0.8",
    "stripe": "^16.12.0",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13"
  }
}
